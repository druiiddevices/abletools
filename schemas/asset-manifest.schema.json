{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://druiiddevices.github.io/abletools/schemas/asset-manifest.schema.json",
  "title": "Abletools Asset Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "pack_name", "version", "style", "asset_type", "seed", "files", "validation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pack_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generator_version": {"type": "string"},
    "style": {"enum": ["DRUIID", "HAZY"]},
    "asset_type": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "tempo_bpm": {"type": "number", "exclusiveMinimum": 0},
    "meter": {"type": "string"},
    "key": {"type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "generation_notes": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "array", "items": {"type": "string"}}
  }
}
