{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://druiiddevices.github.io/abletools/schemas/asset-manifest.schema.json",
  "title": "Abletools Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_name",
    "version",
    "generator_version",
    "style",
    "asset_type",
    "seed",
    "files",
    "format",
    "generation_notes",
    "validation",
    "dependencies"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pack_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "generator_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "style": {"enum": ["DRUIID", "HAZY"]},
    "asset_type": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "tempo_bpm": {"type": "number", "exclusiveMinimum": 0},
    "meter": {"type": "string", "minLength": 1},
    "key": {"type": "string", "minLength": 1},
    "root": {"type": "string", "minLength": 1},
    "scale": {"type": "string", "minLength": 1},
    "bars": {"type": "integer", "minimum": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "recipe": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "format", "metadata"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "format": {"type": "object", "minProperties": 1},
          "metadata": {
            "type": "object",
            "minProperties": 1,
            "required": ["role", "seed"]
          }
        }
      }
    },
    "format": {"type": "object", "minProperties": 1},
    "generation_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "validator", "result"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "validator": {"type": "string", "minLength": 1},
          "result": {"type": "object", "minProperties": 1}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
